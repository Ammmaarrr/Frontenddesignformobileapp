# Vite Environment Variables for Production

# Backend API URL (commented out to trigger HuggingFace fallback)
# VITE_API_BASE_URL=https://qari-app-production.up.railway.app

# HuggingFace Space URL for ML inference
VITE_HF_SPACE_URL=https://ammarsial-qari-ml.hf.space

# Enable HuggingFace fallback (default: true)
VITE_USE_HUGGINGFACE=true

# API timeout in milliseconds
VITE_API_TIMEOUT=30000
